<UserControl x:Class="SmartMonitor.App.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="36,28,36,36">
        <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Open log folder" Click="OpenFolder_Click" Margin="0,0,8,0" />
            <Button Content="Copy to clipboard" Click="Copy_Click" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="4">
            <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="440"
                     TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
    </StackPanel>
</UserControl>
