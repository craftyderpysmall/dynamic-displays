<UserControl x:Class="SmartMonitor.App.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="36,28,36,36">
        <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Every app follows your cursor automatically — you don't need to add apps for that. Use this page to exclude apps that should stay put, and to set up launch shortcuts." />

        <!-- Exclusions -->
        <TextBlock Text="Excluded apps (never moved)" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="Good candidates: games, overlays, screen recorders, or any app that should always stay on one monitor." />
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Add" Click="AddExclusion_Click" MinWidth="80" Margin="8,0,0,0" />
                    <ComboBox x:Name="ExclusionInput" IsEditable="True" DropDownOpened="ExclusionInput_DropDownOpened"
                              ToolTip="Type an exe name (e.g. obs64.exe) or pick a running app" />
                </DockPanel>
                <ListBox x:Name="ExclusionList" MinHeight="40" MaxHeight="180" BorderThickness="0" />
                <Button Content="Remove selected" Click="RemoveExclusion_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Launcher -->
        <TextBlock Text="Launcher" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="Optional. Apps here appear in the tray menu, and you can create Smart shortcuts for the desktop or Start menu (and pin those to the taskbar yourself). A Smart shortcut records the monitor you launched it on and, if the app is already running, brings the existing window there instead of opening a duplicate." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Add program or shortcut…" Click="AddApp_Click" Style="{StaticResource AccentButton}" />
                    <ComboBox x:Name="RunningAppPicker" Width="260" Margin="8,0,0,0" DropDownOpened="RunningAppPicker_DropDownOpened"
                              SelectionChanged="RunningAppPicker_SelectionChanged" ToolTip="Add an app that is running right now">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Text="← or add a running app" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <ListBox x:Name="AppList" MinHeight="40" MaxHeight="220" BorderThickness="0" DisplayMemberPath="Name"
                         SelectionChanged="AppList_SelectionChanged" />
            </StackPanel>
        </Border>

        <!-- Selected app editor -->
        <Border x:Name="Editor" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Body}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" LostFocus="Editor_Changed" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="Program" Style="{StaticResource Body}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TargetBox" LostFocus="Editor_Changed" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Text="Arguments" Style="{StaticResource Body}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ArgsBox" LostFocus="Editor_Changed" Margin="0,0,0,8" />
                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <TextBlock Text="Window process names" Style="{StaticResource Body}" />
                    <TextBlock Text="comma separated, optional" Style="{StaticResource Caption}" />
                </StackPanel>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ProcessBox" LostFocus="Editor_Changed" Margin="0,0,0,8"
                         ToolTip="For apps whose launcher is a different exe than the window, e.g. Discord: Update.exe starts Discord.exe" />
                <TextBlock Grid.Row="4" Text="If already running" Style="{StaticResource Body}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="IfRunningBox" SelectionChanged="Editor_Changed" Margin="0,0,0,8">
                    <ComboBoxItem Content="Bring the existing window to this monitor" />
                    <ComboBoxItem Content="Always start a new instance" />
                </ComboBox>
                <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Button Content="Launch now" Click="Launch_Click" Margin="0,0,8,8" Style="{StaticResource AccentButton}" />
                    <Button Content="Create desktop shortcut" Click="DesktopShortcut_Click" Margin="0,0,8,8" />
                    <Button Content="Create Start menu shortcut" Click="StartShortcut_Click" Margin="0,0,8,8" />
                    <Button Content="Remove" Click="RemoveApp_Click" Margin="0,0,8,8" />
                </WrapPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="AppStatus" Style="{StaticResource Caption}" Margin="2,4,0,0" />
    </StackPanel>
</UserControl>
