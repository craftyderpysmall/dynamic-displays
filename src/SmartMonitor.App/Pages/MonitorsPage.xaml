<UserControl x:Class="SmartMonitor.App.Pages.MonitorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="36,28,36,36">
        <TextBlock Text="Monitors" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Your displays as Windows arranges them. The highlighted monitor is the one your cursor is on — that is where windows will open." />

        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <Grid x:Name="LayoutHost" Height="250" SizeChanged="LayoutHost_SizeChanged" ClipToBounds="True">
                    <Canvas x:Name="LayoutCanvas" />
                </Grid>
                <DockPanel Margin="0,14,0,0">
                    <TextBlock x:Name="CursorText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0" MinWidth="90" />
                        <Button Content="Identify" Click="Identify_Click" Style="{StaticResource AccentButton}" MinWidth="90" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Details" Style="{StaticResource SectionHeader}" />
        <ItemsControl x:Name="DetailsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" VerticalAlignment="Top"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Number}" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Visibility="{Binding PrimaryVisibility}" Margin="10,0,0,0" Padding="7,1" CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="Primary" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Line1}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Line2}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
