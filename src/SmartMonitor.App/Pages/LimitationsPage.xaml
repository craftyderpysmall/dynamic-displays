<UserControl x:Class="SmartMonitor.App.Pages.LimitationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="H" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="36,28,36,36">
        <TextBlock Text="How it works &amp; limitations" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="What Smart Monitor can and cannot do on Windows 11." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="How a window's monitor is chosen" />
                <TextBlock Style="{StaticResource P}" Text="Windows doesn't tell apps where you clicked. Smart Monitor watches for windows that appear, are restored, or come to the front, and moves them to the monitor your mouse cursor is on at that moment. When you click a taskbar button, desktop icon or link, the cursor is on the monitor where you clicked, so the window comes to you." />
                <TextBlock Style="{StaticResource P}" Text="Smart shortcuts (Apps page) are more precise: Windows passes the monitor of the click to the program it starts, and Smart Monitor reads that directly. The Test page shows which method was used for the last launch." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="Keyboard launches" />
                <TextBlock Style="{StaticResource P}" Text="Win+1…9, Start-menu search with the keyboard, Win+R and similar have no click, so the cursor's current monitor is used." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="Administrator windows and UAC prompts" />
                <TextBlock Style="{StaticResource P}" Text="Windows blocks normal apps from moving windows of apps running as administrator. Turn on “Run elevated” in Behavior to manage those too." />
                <TextBlock Style="{StaticResource P}" Text="UAC prompts can't be moved or duplicated by any app: Windows shows them on a separate secure desktop that covers every monitor. Disabling the secure desktop policy keeps other monitors usable but lowers security; Smart Monitor never changes it for you." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="Apps that position themselves" />
                <TextBlock Style="{StaticResource P}" Text="Some apps restore a saved position after opening, or keep moving their window. Smart Monitor checks once more shortly after a window opens; if an app still fights it, add it to the excluded apps." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="Pinned Smart shortcuts" />
                <TextBlock Style="{StaticResource P}" Text="Windows doesn't let apps pin to the taskbar, so you pin Smart shortcuts yourself. A pinned Smart shortcut shows as a separate taskbar button from the app's own running button. You usually don't need one: with Follow cursor on, the app's normal taskbar button already works on every monitor." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="What is never touched" />
                <TextBlock Style="{StaticResource P}" Text="Dialogs that belong to an app window, windows you are dragging or clicking, full-screen games and video (optional), Windows shell UI, windows on other virtual desktops, and anything while Follow cursor is off (the window hooks are removed entirely)." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
